{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/apps/api/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "/apps/web/$1"
    }
  ],
  "functions": {
    "apps/api/main.py": {
      "runtime": "vercel-python@0.1.0"
    }
  },
  "crons": [
    {
      "path": "/api/worker/cleanup-exports",
      "schedule": "0 */6 * * *"
    }
  ]
}
