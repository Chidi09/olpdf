<mjml>
  <mj-head>
    <mj-title>Reset your password — OLPDF</mj-title>
    <mj-preview>We received a request to reset your OLPDF password. Click to set a new one.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#f0f0f0" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0c">

    <!-- Header: Logo -->
    <mj-section background-color="#0a0a0c" padding="28px 0 20px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="24px" font-weight="900" letter-spacing="4px" padding="0">
          <span style="color:#f97316;">OL</span><span style="color:#f0f0f0;">PDF</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Orange accent line -->
    <mj-section background-color="#f97316" padding="0">
      <mj-column>
        <mj-spacer height="3px" />
      </mj-column>
    </mj-section>

    <!-- Main card -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="40px 32px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#f0f0f0" padding-bottom="8px">
          Reset your password
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="28px">
          Hi {{ name }}, we received a request to reset the password for your OLPDF account. Click the button below to choose a new password.
        </mj-text>
        <mj-button background-color="#f97316" color="#ffffff" border-radius="6px" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="14px" inner-padding="14px 28px" href="{{ reset_url }}" align="center">
          Reset Password
        </mj-button>
        <mj-text color="#6b7280" font-size="13px" align="center" padding-top="24px">
          This link expires in <strong style="color:#f0f0f0;">1 hour</strong>.
        </mj-text>
        <mj-text color="#6b7280" font-size="13px" align="center" padding-top="4px">
          If you didn't request a password reset, you can safely ignore this email. Your account is secure and no changes have been made.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0a0a0c" padding="24px 0 36px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="13px" font-weight="900" letter-spacing="4px" padding-bottom="8px">
          <span style="color:#f97316;">OL</span><span style="color:#f0f0f0;">PDF</span>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0">
          <a href="{{ app_url }}" style="color:#6b7280; text-decoration:none;">olpdf.xyz</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/settings" style="color:#6b7280; text-decoration:none;">Account Settings</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/unsubscribe" style="color:#6b7280; text-decoration:none;">Unsubscribe</a>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding-top="8px">
          &copy; 2025 OLPDF. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
