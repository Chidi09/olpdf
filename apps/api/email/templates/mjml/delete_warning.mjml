<mjml>
  <mj-head>
    <mj-title>Account scheduled for deletion — OLPDF</mj-title>
    <mj-preview>Your OLPDF account is scheduled for permanent deletion on {{ deletion_date }}. Act now to cancel.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#f0f0f0" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0c">

    <!-- Header: Logo -->
    <mj-section background-color="#0a0a0c" padding="28px 0 12px">
      <mj-column>
        <mj-image src="{{ app_url }}/brand/generated/icon-192.png" width="44px" alt="OLPDF" align="center" padding="0 0 10px 0" />
        <mj-text align="center" font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="900" letter-spacing="2px" padding="0">
          <span style="color:#f0f0f0;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Orange accent line -->
    <mj-section background-color="#f97316" padding="0">
      <mj-column>
        <mj-spacer height="3px" />
      </mj-column>
    </mj-section>

    <!-- Main card with red warning border -->
    <mj-section background-color="#111113" border-left="1px solid #ef4444" border-right="1px solid #ef4444" border-top="3px solid #ef4444" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#ef4444" letter-spacing="2px" padding-bottom="8px">
          &#128680; ACCOUNT DELETION WARNING
        </mj-text>
        <mj-text font-size="28px" font-weight="700" color="#f0f0f0" padding-bottom="8px">
          Account scheduled for deletion
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="24px">
          Hi {{ name }}, your OLPDF account and all associated data are scheduled to be <strong style="color:#ef4444;">permanently deleted</strong> on <strong style="color:#ef4444;">{{ deletion_date }}</strong>. This action cannot be undone.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- What will be deleted -->
    <mj-section background-color="#111113" border-left="1px solid #ef4444" border-right="1px solid #ef4444" padding="0 32px 24px">
      <mj-column background-color="#1a0e0e" border-left="3px solid #ef4444" padding="16px 20px" border-radius="4px">
        <mj-text font-size="14px" color="#f87171" font-weight="600" padding-bottom="12px" padding-top="0">
          The following will be permanently deleted:
        </mj-text>
        <mj-text font-size="14px" color="#9ca3af" padding-bottom="6px" padding-top="0">
          &#9642;&nbsp; All uploaded documents and processed files
        </mj-text>
        <mj-text font-size="14px" color="#9ca3af" padding-bottom="6px" padding-top="0">
          &#9642;&nbsp; All API keys and webhook configurations
        </mj-text>
        <mj-text font-size="14px" color="#9ca3af" padding-bottom="6px" padding-top="0">
          &#9642;&nbsp; All exports and generated files
        </mj-text>
        <mj-text font-size="14px" color="#9ca3af" padding-bottom="0" padding-top="0">
          &#9642;&nbsp; All billing history and invoices
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Primary CTA -->
    <mj-section background-color="#111113" border-left="1px solid #ef4444" border-right="1px solid #ef4444" padding="8px 32px 24px">
      <mj-column>
        <mj-button background-color="#f97316" color="#ffffff" border-radius="6px" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="14px" inner-padding="14px 28px" href="{{ cancel_url }}" align="center">
          Cancel Deletion
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Confirm deletion link -->
    <mj-section background-color="#111113" border-left="1px solid #ef4444" border-right="1px solid #ef4444" border-bottom="1px solid #2a2a2e" padding="0 32px 40px">
      <mj-column>
        <mj-text align="center" font-size="13px" color="#6b7280" padding="0">
          If you still want your account deleted, no action is needed — it will be deleted automatically on {{ deletion_date }}.
          <br /><br />
          <a href="{{ cancel_url }}?action=confirm" style="color:#6b7280; text-decoration:underline; font-size:12px;">Confirm deletion now</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0a0a0c" padding="24px 0 36px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="13px" font-weight="900" letter-spacing="4px" padding-bottom="8px">
          <span style="color:#9ca3af;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0">
          <a href="{{ app_url }}" style="color:#6b7280; text-decoration:none;">olpdf.xyz</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/settings" style="color:#6b7280; text-decoration:none;">Account Settings</a>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding-top="8px">
          &copy; 2026 OLPDF. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
