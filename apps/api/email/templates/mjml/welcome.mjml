<mjml>
  <mj-head>
    <mj-title>Welcome to OLPDF</mj-title>
    <mj-preview>You're in. Start processing PDFs via API today.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#f0f0f0" font-size="15px" line-height="1.6" />
    </mj-attributes>
    <mj-style>
      .logo-ol { color: #f97316; font-family: Georgia, serif; font-size: 24px; font-weight: 900; letter-spacing: 4px; }
      .logo-pdf { color: #f0f0f0; font-family: Georgia, serif; font-size: 24px; font-weight: 900; letter-spacing: 4px; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#0a0a0c">

    <!-- Header: Logo -->
    <mj-section background-color="#0a0a0c" padding="28px 0 12px">
      <mj-column>
        <mj-image src="{{ app_url }}/brand/generated/icon-192.png" width="44px" alt="OLPDF" align="center" padding="0 0 10px 0" />
        <mj-text align="center" font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="900" letter-spacing="2px" padding="0">
          <span style="color:#f0f0f0;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Orange accent line -->
    <mj-section background-color="#f97316" padding="0">
      <mj-column>
        <mj-spacer height="3px" />
      </mj-column>
    </mj-section>

    <!-- Main card -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="40px 32px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#f0f0f0" padding-bottom="8px">
          You're in.
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="24px">
          Hi {{ name }}, welcome to OLPDF — a professional PDF processing platform built for developers and teams who need reliable, high-performance document automation via API.
        </mj-text>
        <mj-text color="#f0f0f0" font-weight="600" padding-bottom="8px">
          Here's what you can do right now:
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="4px">
          &#9642;&nbsp; <strong style="color:#f0f0f0;">Parse any PDF via API</strong> — extract text, tables, metadata, and structure programmatically.
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="4px">
          &#9642;&nbsp; <strong style="color:#f0f0f0;">Export to EPUB3</strong> — convert documents to reflowable, accessible EPUB3 format in one call.
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="28px">
          &#9642;&nbsp; <strong style="color:#f0f0f0;">AI-powered rewrite</strong> — clean, restructure, and reformat document content with AI.
        </mj-text>
        <mj-button background-color="#f97316" color="#ffffff" border-radius="6px" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="14px" inner-padding="14px 28px" href="{{ app_url }}/dashboard" align="center">
          Open Dashboard
        </mj-button>
        <mj-text color="#6b7280" font-size="13px" align="center" padding-top="24px">
          <em>P.S. OLPDF is currently in free beta — no credit card required. Enjoy full access while it lasts.</em>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0a0a0c" padding="24px 0 36px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="13px" font-weight="900" letter-spacing="4px" padding-bottom="8px">
          <span style="color:#9ca3af;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0">
          <a href="{{ app_url }}" style="color:#6b7280; text-decoration:none;">olpdf.xyz</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/settings" style="color:#6b7280; text-decoration:none;">Account Settings</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/unsubscribe" style="color:#6b7280; text-decoration:none;">Unsubscribe</a>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding-top="8px">
          &copy; 2026 OLPDF. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
