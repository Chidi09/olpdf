<mjml>
  <mj-head>
    <mj-title>Webhook delivery failing — OLPDF</mj-title>
    <mj-preview>Your webhook endpoint has failed {{ failure_count }} consecutive times. Action required.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#f0f0f0" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0c">

    <!-- Header: Logo -->
    <mj-section background-color="#0a0a0c" padding="28px 0 20px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="24px" font-weight="900" letter-spacing="4px" padding="0">
          <span style="color:#f97316;">OL</span><span style="color:#f0f0f0;">PDF</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Orange accent line -->
    <mj-section background-color="#f97316" padding="0">
      <mj-column>
        <mj-spacer height="3px" />
      </mj-column>
    </mj-section>

    <!-- Main card -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="13px" font-weight="700" color="#f59e0b" letter-spacing="2px" padding-bottom="8px">
          &#9888; WEBHOOK WARNING
        </mj-text>
        <mj-text font-size="28px" font-weight="700" color="#f0f0f0" padding-bottom="8px">
          Webhook delivery failing
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="24px">
          Hi {{ name }}, your webhook endpoint has failed to respond successfully to <strong style="color:#f59e0b;">{{ failure_count }} consecutive</strong> delivery attempts for <strong style="color:#f0f0f0;">{{ event_type }}</strong> events. Please check your endpoint and ensure it is responding correctly.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Failure details box -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="0 32px 24px">
      <mj-column background-color="#1f1a0e" border-left="3px solid #f59e0b" padding="16px 20px" border-radius="4px">
        <mj-text font-size="13px" color="#9ca3af" padding-bottom="4px" padding-top="0">
          <strong style="color:#f0f0f0;">Endpoint URL</strong>
        </mj-text>
        <mj-text font-size="13px" color="#f0f0f0" font-family="Courier New, Courier, monospace" padding-top="0" padding-bottom="12px">
          {{ endpoint_url }}
        </mj-text>
        <mj-text font-size="13px" color="#9ca3af" padding-bottom="4px" padding-top="0">
          <strong style="color:#f0f0f0;">Event type</strong>
        </mj-text>
        <mj-text font-size="14px" color="#f0f0f0" padding-top="0" padding-bottom="12px">
          {{ event_type }}
        </mj-text>
        <mj-text font-size="13px" color="#9ca3af" padding-bottom="4px" padding-top="0">
          <strong style="color:#f0f0f0;">Consecutive failures</strong>
        </mj-text>
        <mj-text font-size="14px" color="#f59e0b" font-weight="700" padding-top="0" padding-bottom="12px">
          {{ failure_count }}
        </mj-text>
        <mj-text font-size="13px" color="#9ca3af" padding-bottom="4px" padding-top="0">
          <strong style="color:#f0f0f0;">Next retry</strong>
        </mj-text>
        <mj-text font-size="14px" color="#f0f0f0" padding-top="0" padding-bottom="0">
          {{ next_retry }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Warning note -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="0 32px 24px">
      <mj-column>
        <mj-text font-size="13px" color="#9ca3af" padding="0">
          After <strong style="color:#f0f0f0;">10 consecutive failures</strong>, the endpoint will be automatically disabled. Fix the endpoint before then to avoid losing webhook notifications.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="0 32px 40px">
      <mj-column>
        <mj-button background-color="#f97316" color="#ffffff" border-radius="6px" font-family="Arial, Helvetica, sans-serif" font-weight="700" font-size="14px" inner-padding="14px 28px" href="{{ app_url }}/settings/webhooks" align="center">
          Manage Webhooks
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0a0a0c" padding="24px 0 36px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="13px" font-weight="900" letter-spacing="4px" padding-bottom="8px">
          <span style="color:#f97316;">OL</span><span style="color:#f0f0f0;">PDF</span>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0">
          <a href="{{ app_url }}" style="color:#6b7280; text-decoration:none;">olpdf.xyz</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/settings" style="color:#6b7280; text-decoration:none;">Account Settings</a>
          &nbsp;&bull;&nbsp;
          <a href="{{ app_url }}/unsubscribe" style="color:#6b7280; text-decoration:none;">Unsubscribe</a>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding-top="8px">
          &copy; 2025 OLPDF. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
