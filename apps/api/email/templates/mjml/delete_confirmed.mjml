<mjml>
  <mj-head>
    <mj-title>Account deleted — OLPDF</mj-title>
    <mj-preview>Your OLPDF account has been permanently deleted. This is our final message to you.</mj-preview>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#f0f0f0" font-size="15px" line-height="1.6" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0c">

    <!-- Header: Logo -->
    <mj-section background-color="#0a0a0c" padding="28px 0 12px">
      <mj-column>
        <mj-image src="{{ app_url }}/brand/generated/icon-192.png" width="44px" alt="OLPDF" align="center" padding="0 0 10px 0" />
        <mj-text align="center" font-family="Arial, Helvetica, sans-serif" font-size="22px" font-weight="900" letter-spacing="2px" padding="0">
          <span style="color:#f0f0f0;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Orange accent line -->
    <mj-section background-color="#f97316" padding="0">
      <mj-column>
        <mj-spacer height="3px" />
      </mj-column>
    </mj-section>

    <!-- Main card -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="40px 32px 24px">
      <mj-column>
        <mj-text font-size="28px" font-weight="700" color="#f0f0f0" padding-bottom="8px">
          Account deleted
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="20px">
          Hi {{ name }}, your OLPDF account and all associated data have been permanently deleted as requested.
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="20px">
          This includes all your documents, API keys, exports, and billing history. Nothing has been retained.
        </mj-text>
        <mj-text color="#9ca3af" padding-bottom="20px">
          This is the last email you'll receive from us. We're sorry to see you go, and we hope your experience with OLPDF was a positive one. If you have feedback on how we could have done better, we'd genuinely appreciate hearing it.
        </mj-text>
        <mj-text color="#6b7280" font-size="14px" padding-bottom="0">
          Take care, and best of luck with your projects.
          <br /><br />
          — The OLPDF Team
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Sign up again note -->
    <mj-section background-color="#111113" border-left="1px solid #2a2a2e" border-right="1px solid #2a2a2e" padding="0 32px 40px">
      <mj-column>
        <mj-divider border-color="#2a2a2e" border-width="1px" padding="0 0 24px" />
        <mj-text align="center" font-size="13px" color="#6b7280" padding="0">
          Changed your mind? You can always <a href="{{ app_url }}/signup" style="color:#f97316; text-decoration:none;">create a new OLPDF account</a> at any time.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#0a0a0c" padding="24px 0 36px">
      <mj-column>
        <mj-text align="center" font-family="Georgia, serif" font-size="13px" font-weight="900" letter-spacing="4px" padding-bottom="8px">
          <span style="color:#9ca3af;">OL</span><span style="color:#f97316;">PDF</span>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding="0">
          <a href="{{ app_url }}" style="color:#6b7280; text-decoration:none;">olpdf.xyz</a>
        </mj-text>
        <mj-text align="center" font-size="12px" color="#6b7280" padding-top="8px">
          &copy; 2026 OLPDF. All rights reserved.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
