{
  "name": "@olpdf/vue",
  "version": "0.1.0",
  "description": "Vue 3 / Nuxt component wrapper for @olpdf/embed",
  "license": "MIT",
  "author": "OLPDF <hello@olpdf.xyz>",
  "homepage": "https://olpdf.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chidi09/olpdf.git",
    "directory": "packages/olpdf-vue"
  },
  "keywords": ["pdf", "editor", "vue", "nuxt", "olpdf"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist --external vue",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@olpdf/embed": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vue": "^3"
  }
}
