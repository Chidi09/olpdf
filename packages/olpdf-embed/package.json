{
  "name": "@olpdf/embed",
  "version": "0.1.0",
  "description": "Embed the OLPDF PDF editor into any web app via a postMessage bridge",
  "license": "MIT",
  "author": "OLPDF <hello@olpdf.xyz>",
  "homepage": "https://olpdf.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chidi09/olpdf.git",
    "directory": "packages/olpdf-embed"
  },
  "keywords": ["pdf", "editor", "embed", "iframe", "olpdf"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.js --format esm,cjs --dts --out-dir dist",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.0.0"
  }
}
