{
  "name": "@olpdf/embed",
  "version": "0.1.0",
  "description": "Embed the OLPDF PDF editor into any web app via a postMessage bridge",
  "license": "MIT",
  "author": "OLPDF <hello@olpdf.xyz>",
  "homepage": "https://olpdf.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chidi09/olpdf.git",
    "directory": "packages/olpdf-embed"
  },
  "keywords": [
    "pdf",
    "editor",
    "embed",
    "iframe",
    "olpdf"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "test": "vitest run --environment jsdom",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
