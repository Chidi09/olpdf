{
  "name": "@olpdf/react",
  "version": "0.1.0",
  "description": "React component wrapper for @olpdf/embed",
  "license": "MIT",
  "author": "OLPDF <hello@olpdf.xyz>",
  "homepage": "https://olpdf.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chidi09/olpdf.git",
    "directory": "packages/olpdf-react"
  },
  "keywords": ["pdf", "editor", "react", "nextjs", "olpdf"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --out-dir dist --external react",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@olpdf/embed": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
