# =============================================================================
# olpdf — Environment Variables Reference
# Copy this file to .env and fill in real values before starting the API.
# Never commit .env to version control.
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # Server-only — never expose to browser
SUPABASE_JWT_SECRET=<jwt-secret>               # Found in Supabase → Settings → API

# ── QStash (background job queue) ────────────────────────────────────────────
QSTASH_TOKEN=<qstash-token>
QSTASH_CURRENT_SIGNING_KEY=<qstash-current-signing-key>

# ── Modal (serverless workers) ────────────────────────────────────────────────
MODAL_WORKER_URL=https://<your-modal-app>.modal.run
WORKER_SECRET=<shared-secret-between-api-and-worker>

# ── AI ────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=<gemini-api-key>
# Optional — Anthropic Claude for AI features
# ANTHROPIC_API_KEY=<anthropic-api-key>

# ── Cloudflare R2 (object storage) ───────────────────────────────────────────
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=olpdf-documents

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# In development with OLPDF_DEV_MODE=true this falls back to localhost:3000.
ALLOWED_ORIGINS=https://olpdf.xyz,https://staging.olpdf.xyz

# ── Email / SMTP (optional) ───────────────────────────────────────────────────
# If not set, transactional emails are disabled.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=<resend-api-key>
EMAIL_FROM=no-reply@olpdf.xyz

# ── Monitoring (optional) ─────────────────────────────────────────────────────
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ── Development flags ─────────────────────────────────────────────────────────
# Set to "true" locally to skip mandatory env var validation and allow localhost CORS.
# NEVER set this in staging or production.
OLPDF_DEV_MODE=false
NEXT_PUBLIC_OLPDF_DEV_MODE=false

# ── Next.js (apps/web) ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>          # Safe to expose — RLS enforces access
NEXT_PUBLIC_API_URL=https://api.olpdf.xyz
